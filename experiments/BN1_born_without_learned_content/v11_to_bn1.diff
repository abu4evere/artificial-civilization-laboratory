@@ -551,6 +551,13 @@ def _born(world, mother, father, genes, name, sex, gen):
     # Habits start as a softened blend of the parents'.
     fq = father.q if father and father.alive else mother.q
     child.q = [0.25 * (a + b) for a, b in zip(mother.q, fq)]
+    if world.cfg.newborn_values == 1:                 # BN1: born without learned content
+        child.q = [0.0] * len(child.q)
+    elif world.cfg.newborn_values == 2:               # BN1 control: the same numbers, shuffled across actions within each situation
+        for s in range(0, len(child.q), N_ACTIONS):
+            block = child.q[s:s + N_ACTIONS]
+            world.rng.shuffle(block)
+            child.q[s:s + N_ACTIONS] = block
     world.people[child.id] = child
     world._living = None
     world.occ.setdefault(child.loc, []).append(child.id)
