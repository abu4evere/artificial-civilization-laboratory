+++ ES1_expected_lookahead/code_es1/acl/biology.py	2026-10-31 19:28:14.253809300 -0400
@@ -390,7 +390,16 @@
     c = world.cfg
     near = world.people_near(p.loc, c.reach, exclude=p.id)
     nxt = context_index(world, p, bool(near))
-    future = max(p.q[nxt * N_ACTIONS:(nxt + 1) * N_ACTIONS])
+    nq = p.q[nxt * N_ACTIONS:(nxt + 1) * N_ACTIONS]
+    if c.expected_lookahead:
+        # ES1: what the next situation is worth on average, the way this person would choose in it (their habits'
+        # share of the choice), instead of its single best-looking option.
+        k = c.learned_weight / c.choice_temperature
+        top = max(nq)
+        w = [math.exp(k * (v - top)) for v in nq]
+        future = sum(wi * v for wi, v in zip(w, nq)) / sum(w)
+    else:
+        future = max(nq)
     r = p.reward + 2.0 * (p.mood - p.mood_before)
     i = p.last_ctx * N_ACTIONS + A[p.last_action]
     p.q[i] = clamp(p.q[i] + c.learning_rate * (r + c.discount * future - p.q[i]), -1.5, 1.5)
