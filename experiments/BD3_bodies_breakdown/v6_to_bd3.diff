+def body_meat_left(world, owner, entry) -> float:
+    """BD3: how much of a body's store is its flesh, by v6's own accounting in _rot_by_warmth (the flesh is what
+    warmth has left of the meat, capped by the store; the rest is what they carried). 0 for any other store."""
+    b = next((x for x in world.bodies if x["id"] == owner and x["flesh"]), None)
+    if b is None or "meat0" not in b:
+        return 0.0
+    return min(entry[1], max(0.0, b["meat0"] * (1.0 - b["add"] / BONES_ADD)))
+
+
+def takeable(world, owner, entry) -> float:
+    """BD3 probe: food that can be taken from a store. With bd3_no_eat, a body's flesh cannot."""
+    if world.cfg.bd3_no_eat and world.cfg.bodies_stay:
+        return max(0.0, entry[1] - body_meat_left(world, owner, entry))
+    return entry[1]
+
+
 def rot_weeks(world) -> int:
     """Weeks until a body counts as rotten: when ROT_SHARE of loose food would have rotted at v3's rate."""
