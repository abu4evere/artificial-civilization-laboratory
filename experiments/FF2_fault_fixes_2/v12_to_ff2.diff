diff -r -u --strip-trailing-cr -x __pycache__ NV12_nature_v12/code_v12/acl/fauna.py FF2_fault_fixes_2/code_ff2/acl/fauna.py
--- NV12_nature_v12/code_v12/acl/fauna.py	2026-11-03 02:27:26.049618500 -0500
+++ FF2_fault_fixes_2/code_ff2/acl/fauna.py	2026-11-03 11:44:22.707853100 -0500
@@ -127,6 +127,22 @@
     return (info["meat"] * taken, info["hide"] * taken, info["bone"] * taken, sp)
 
 
+def expected_take(world, loc: tuple) -> float:
+    """FF2 (F8): the meat a success here would give, as seen now: the mean, over the herds take_prey would choose from
+    (the same list), of the species' meat x the number it would take. 0 if there are none. Reads only."""
+    prey = [g for g in near(world, loc, 0) if g["sp"] in PREY and g["n"] > 0]
+    fish = fish_by(world, loc)
+    if fish is not None and fish["n"] > 0:
+        prey.append(fish)
+    if not prey:
+        return 0.0
+    total = 0.0
+    for g in prey:
+        info = SPECIES[g["sp"]]
+        total += info["meat"] * min(g["n"], 1 if info["meat"] >= 10 else max(1, round(10.0 / info["meat"])))
+    return total / len(prey)
+
+
 def _lives_on(world, sp: str, loc: tuple) -> bool:
     return world.tile(loc).biome in SPECIES[sp]["lives"]
 
diff -r -u --strip-trailing-cr -x __pycache__ NV12_nature_v12/code_v12/acl/matter.py FF2_fault_fixes_2/code_ff2/acl/matter.py
--- NV12_nature_v12/code_v12/acl/matter.py	2026-11-03 02:27:25.987624500 -0500
+++ FF2_fault_fixes_2/code_ff2/acl/matter.py	2026-11-03 11:44:22.707853100 -0500
@@ -258,6 +258,21 @@
         p.items.pop(index)
 
 
+def receive(world, p, kind: str, amount: float, loc: tuple, how: str) -> None:
+    """Raw material coming to p at loc (spoils of a kill, an inheritance). FF2 (F4): with fix_mat_limit, what goes past
+    the material limit is left on that tile's pile, kept and not deleted; 0 = v12 (p keeps it all). The runner's log
+    (read by nothing here) counts the units past the limit either way."""
+    over = min(amount, max(0.0, p.mat_total() + amount - world.cfg.material_limit))
+    log = getattr(world, "ff2log", None)
+    if log is not None and over > 0:
+        log.append(("mat_over", how, over))
+    if world.cfg.fix_mat_limit and over > 0:
+        tile = world.tile(loc)
+        tile.pile[kind] = tile.pile.get(kind, 0.0) + over
+        amount -= over
+    p.mats[kind] += amount
+
+
 def carry_capacity(world, p) -> float:
     _, f = best_item(p, "carry")
     return world.cfg.carry_limit * f
