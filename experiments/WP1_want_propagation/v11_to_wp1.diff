+def _wanted_parts_deep(p: Person) -> dict:
+    """WP1 (A2): a valued thing's value flows to its missing made parts at 0.8 per step, through the whole chain: each
+    part takes the largest 0.8 x value of the things it goes into (own value or flowed), until nothing changes. Never
+    summed, so a loop cannot amplify it."""
+    out: dict = {}
+    for _ in range(len(p.recipes) + 1):
+        changed = False
+        for sig, recipe in p.recipes.items():
+            v = max(p.itemval.get(sig, 0.0), out.get(sig, 0.0))
+            if v <= 0 or _holding(p, sig):
+                continue
+            parts = list(recipe.get("parts", ())) + ([recipe["part"]] if recipe["verb"] == "heat" else [])
+            for part in parts:
+                if part not in MATERIALS and not _holding(p, part, worn_ok=True) and 0.8 * v > out.get(part, 0.0):
+                    out[part] = 0.8 * v
+                    changed = True
+        if not changed:
+            break
+    return out
