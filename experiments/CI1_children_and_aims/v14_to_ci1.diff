+def _needs(recipe: dict) -> dict:
+    """CI1 (IN): a recipe's inputs as can_make reads them, with the number needed: {name: count}."""
+    v = recipe["verb"]
+    if v == "shape":
+        return {recipe["material"]: 1}
+    if v == "heat":
+        return {recipe["part"]: 1}
+    if v == "fill":
+        return {}
+    if v == "strike":
+        d = {recipe["target"]: 1}
+        d[recipe["tool"]] = d.get(recipe["tool"], 0) + 1 if recipe["tool"] == recipe["target"] else 1
+        return d
+    out: dict = {}
+    for part in recipe["parts"]:
+        out[part] = out.get(part, 0) + 1
+    out[recipe["binder"]] = out.get(recipe["binder"], 0) + 1
+    return out
+
+
+def _used_up(recipe: dict) -> dict:
+    """CI1 (IN; amendment 1): what a craft by this recipe uses up. A strike uses up the struck material, not the hammer;
+    heating at a fire stays open, so a heat craft protects nothing."""
+    v = recipe["verb"]
+    if v == "shape":
+        return {recipe["material"]: 1}
+    if v == "strike":
+        return {recipe["target"]: 1}
+    if v in ("heat", "fill"):
+        return {}
+    return _needs(recipe)
+
+
+def _held(p: Person, name: str) -> float:
+    return p.mats.get(name, 0.0) if name in MATERIALS else sum(1 for it in p.items if it["sig"] == name)
+
+
+def kept_pieces(world, p: Person) -> dict:
+    """CI1 (IN): what p's held aim keeps, {name: amount}: the aim recipe's inputs up to the number needed and, for each
+    missing made part whose recipe p knows, that part's inputs (one level down). Recomputed from what is held."""
+    if world is None or not world.cfg.held_aim or not p.aim:
+        return {}
+    recipe = p.recipes.get(p.aim)
+    if recipe is None:
+        return {}
+    keep: dict = {}
+    for name, n in _needs(recipe).items():
+        keep[name] = keep.get(name, 0) + n
+        if name not in MATERIALS:
+            missing = n - _held(p, name)
+            sub = p.recipes.get(name)
+            if missing > 0 and sub is not None:
+                for nm, k in _needs(sub).items():
+                    keep[nm] = keep.get(nm, 0) + k * missing
+    return {name: min(n, _held(p, name)) for name, n in keep.items() if _held(p, name) > 0}
+
+
+def uses_kept(p: Person, recipe: dict, keep: dict) -> bool:
+    """CI1 (IN): would a craft by this recipe use up a kept piece?"""
+    return any(_held(p, name) - keep.get(name, 0) < n for name, n in _used_up(recipe).items() if name in keep)
+
+
+def aim_week(world, p: Person) -> None:
+    """CI1 (IN): at p's decision, end the held aim if its time is over, and form one if none is held. Draws nothing from
+    the world's generator (ties as v14 draws them)."""
+    log = getattr(world, "ci1log", None)        # CI1 logging (the runner sets it; not saved; read by nothing here)
+    if p.aim:
+        r = p.recipes.get(p.aim)
+        cause = None
+        if r is None:
+            cause = "forgotten"
+        elif p.itemval.get(p.aim, 0.0) <= 0.05:
+            cause = "value"
+        elif _holding(p, p.aim):
+            cause = "held"
+        elif can_make(p, r):
+            cause = "complete"
+        if cause:
+            if log is not None:
+                log.append(("end", p.id, p.aim, cause))
+            p.aim = None
+    if not p.aim:
+        cands = [s for s, r in p.recipes.items() if r["verb"] != "fill" and p.itemval.get(s, 0.0) > 0.05
+                 and not _holding(p, s) and not can_make(p, r)]
+        if cands:
+            top = max(p.itemval[s] for s in cands)
+            tied = [s for s in cands if p.itemval[s] == top]
+            p.aim = tie_pick(world, p, 5, tied, len(cands))
+            if log is not None:
+                log.append(("form", p.id, p.aim))
+
+
