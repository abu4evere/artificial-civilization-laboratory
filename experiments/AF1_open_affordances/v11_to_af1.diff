+def item_cap(world, p) -> int:
+    """How many made things p can carry. AF1 (K): the best container's carry factor multiplies the limit, as it does for
+    food; the container counts toward its own limit."""
+    if not world.cfg.containers_carry:
+        return world.cfg.item_limit
+    _, f = best_item(p, "carry")
+    return int(world.cfg.item_limit * f)
+
+
+def material_cap(world, p) -> float:
+    """How much raw material p can carry. AF1 (K): multiplied by the best container's carry factor."""
+    if not world.cfg.containers_carry:
+        return world.cfg.material_limit
+    _, f = best_item(p, "carry")
+    return world.cfg.material_limit * f
+
+
 def worn_warmth(p) -> float:
     """Share of cold kept out by what p wears."""
     _, f = best_item(p, "cold")
