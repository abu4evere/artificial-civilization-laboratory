+def apply_held(world, p: Person, opts: list, base: int) -> None:
+    """LH1 rule 1 (ES2's rule): complete last week's habit update at this decision. The look-ahead is the expected
+    habit value of this decision under its real choice: the choice's own softmax over the options' scores (no draw)."""
+    c = world.cfg
+    i, r = p.held
+    p.held = None
+    if opts:
+        top = max(s for s, _ in opts)
+        w = [math.exp((s - top) / c.choice_temperature) for s, _ in opts]
+        future = sum(wi * p.q[base + A[a]] for wi, (_, a) in zip(w, opts)) / sum(w)
+    else:
+        future = p.q[base + A["rest"]]
+    p.q[i] = clamp(p.q[i] + c.learning_rate * (r + c.discount * future - p.q[i]), -1.5, 1.5)
+
+
+def situation_value(p: Person, ctx: int) -> float:
+    """LH1 rule 2: the person's own experienced value of a situation (mean r after deciding there); a situation never
+    experienced takes the mean over all their experienced situations (0 before any experience)."""
+    v = p.vexp
+    if v is None:
+        return 0.0
+    if v[ctx][1] > 0:
+        return v[ctx][0]
+    seen = [m for m, n in v if n > 0]
+    return sum(seen) / len(seen) if seen else 0.0
+
